PROJECT_NAME="DevTrack API"

# Supported environment values:
# - development (alias: dev) [default]
# - staging
# - production (alias: prod)
# - testing (alias: test)
ENVIRONMENT=development

# Security Configuration
# In development/testing, the default placeholder key below is allowed for convenience.
# In production and staging, the default placeholder is strictly prohibited, and SECRET_KEY
# must be set to a unique, cryptographically random secret of at least 32 characters.
# Generate a secure key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="devtrack_super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Rate Limiting (auth endpoints only; see app/core/rate_limit.py)
# Sliding window per client IP. Set RATE_LIMIT_ENABLED=false to turn off
# (e.g. load testing against a staging environment).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_REGISTER_ATTEMPTS=5

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devtrack

# Alternatively, set full DATABASE_URL directly:
# Local Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devtrack
# Neon Cloud Postgres:
# DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint-pooler>.neon.tech/neondb?sslmode=require
# SQLite:
# DATABASE_URL=sqlite:///./devtrack.db
